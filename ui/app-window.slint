import { VerticalBox } from "std-widgets.slint";
import { Font, Theme, Breakpoint } from "@styles";
import { AppState, AppLogic, TabsState } from "@stores/app.slint";
import { TabsGroup, Tabs } from "@components/tabs.slint";
import { ButtonTrigger } from "@components/modal.slint";
import { FieldInput } from "@components/text-edit.slint";
import { Toast } from "@components/toast.slint";
import { CalcDiff } from "@components/calc-diff.slint";
import { SettingsModal } from "@components/settings-modal.slint";

import "./fonts/poppins.medium.ttf";
import "./fonts/poppins.semibold.ttf";

export { AppState, AppLogic } from "@stores/app.slint";

export component AppWindow inherits Window {
	title: "VoruCalc";
	// icon: @image-url("assets/icon.png");
	background: AppState.palette.color-base-300;
	// no-frame: true;
	// resize-border-width: 2px;
	min-width: 240px;
	min-height: 144px;
	preferred-width: 300px;
	preferred-height: 400px;
	default-font-family: "Poppins";
	default-font-size: Font.base;
	forward-focus: scope;
	
	in-out property <[TabsState]> tabs;
	in-out property <string> active-tabs: "calc";

	scope := FocusScope {
		// fields
		VerticalBox {
			padding-bottom: 50px;

			if (active-tabs == "calc"): calc := CalcDiff {
				input-len: parent.width / 2;
			}
			if (active-tabs == "var"): var := FieldInput {
				font-size: Font.lg;
				text <=> AppState.var;
				move-to-last-on-init: true;
				edited => {
					AppLogic.parse-calc();
				}
				on-init => {
					self.focus();
				}
			}
			if (active-tabs == "note"): note := FieldInput {
				font-size: Font.lg;
				text <=> AppState.note;
				move-to-last-on-init: true;
				on-init => {
					self.focus();
				}
			}
		}

		// tabs
		VerticalBox {
			alignment: end;
			z: 2;

			HorizontalLayout {
				spacing: 4px;

				TabsGroup {
					id: "main-nav";
					state: tabs[0];
				}
				ButtonTrigger {
					bg-color: AppState.palette.color-base-200.darker(0.1);
					color: AppState.palette.color-base-content;
					height: 36px;
					width: 36px;
					default-padding-x: false;
					icon: @image-url("icons/cog.svg");
					on-click => {
						settings.show();
					}
				}
			}
		}

		// toast
		VerticalBox {
			alignment: end;
			z: 1;

			Toast {
				text <=> AppState.error-msg;
				variant: "error";
			}

			states [
				show when AppState.error-msg != "": {
					padding-bottom: 50px;
					opacity: 1;

					in {
						animate padding-bottom, opacity {
							duration: 300ms;
							easing: ease-out-quint;
						}
					}
				}
				hide when AppState.error-msg == "": {
					padding-bottom: 40px;
					opacity: 0;
				}
			]
		}
	
		KeyBinding {
			keys: @keys(Control + "1");
			activated => {
				AppLogic.select-tab("main-nav", 0);
			}
		}
		KeyBinding {
			keys: @keys(Control + "2");
			activated => {
				AppLogic.select-tab("main-nav", 1);
			}
		}
		KeyBinding {
			keys: @keys(Control + "3");
			activated => {
				AppLogic.select-tab("main-nav", 2);
			}
		}
		KeyBinding {
			keys: @keys(Control + ",");
			activated => {
				settings.show();
			}
		}

		settings := SettingsModal {
			dialog-width: root.width;
			dialog-height: root.height;
		}
	}

	changed width => {
		AppState.screen-width = self.width;
		AppState.screen = Breakpoint.get-breakpoint(self.width);
	}
}
