import { Button, VerticalBox, Palette } from "std-widgets.slint";
import { Font, Theme, Breakpoint } from "@styles";
import { AppState, AppLogic, TabsState } from "@stores/app.slint";
import { TabsGroup, Tabs } from "@components/tabs.slint";
import { ButtonTrigger } from "@components/modal.slint";
import { FieldInput } from "@components/text-edit.slint";
import { CalcDiff } from "@components/calc-diff.slint";
import { Toast } from "@components/toast.slint";

import "./fonts/poppins.medium.ttf";
import "./fonts/poppins.semibold.ttf";

export { AppState, AppLogic } from "@stores/app.slint";

export component AppWindow inherits Window {
	min-width: 240px;
	preferred-width: 300px;
	preferred-height: 400px;
	default-font-family: "Poppins";
	default-font-size: Font.base;
	
	in-out property <[TabsState]> tabs;
	in-out property <string> active-tabs: "calc";
	
	// fields
	VerticalBox {
		// padding: 0px;
		// spacing: 0px;
		padding-bottom: 50px;

		if (active-tabs == "calc"): CalcDiff {
			input-len: parent.width / 2;
		}
		// Button {
		// 	text: "Increase value";
		// 	clicked => {
		// 		root.request-increase-value();
		// 		AppState.selected-theme = AppState.selected-theme == 1 ? 0 : 1;
		// 		Palette.color-scheme = AppState.palette.is-dark ? dark : light;
		// 	}
		// }
		if (active-tabs == "var"): FieldInput {
			font-size: Font.lg;
			text <=> AppState.var;

			edited => {
				AppLogic.parse-calc();
			}
		}
		if (active-tabs == "note"): FieldInput {
			font-size: Font.lg;
			text <=> AppState.note;
		}
	}

	// tabs
	VerticalBox {
		alignment: end;
		z: 2;

		HorizontalLayout {
			spacing: 4px;

			TabsGroup {
				id: "main-nav";
				state: tabs[0];
			}
			ButtonTrigger {
				bg-color: AppState.palette.color-base-300.darker(0.1);
				color: AppState.palette.color-base-content;
				height: 36px;
				width: 36px;
				default-padding-x: false;
				icon: @image-url("icons/cog.svg");
			}
		}
	}

	// toast
	VerticalBox {
		alignment: end;
		z: 1;

		Toast {
			text <=> AppState.error-msg;
			variant: "error";
		}

		states [
			show when AppState.error-msg != "": {
				padding-bottom: 50px;
				opacity: 1;

				in {
					animate padding-bottom, opacity {
						duration: 300ms;
						easing: ease-out-quint;
					}
				}
			}
			hide when AppState.error-msg == "": {
				padding-bottom: 40px;
				opacity: 0;
			}
		]
	}

	changed width => {
		AppState.screen-width = self.width;
		AppState.screen = Breakpoint.get-breakpoint(self.width);
	}
}
