import { Button, VerticalBox } from "std-widgets.slint";
import { TabsGroup, Tabs } from "@components/tabs.slint";
import { Style, Theme, Breakpoint } from "@styles";
import { AppState, TabsState } from "@stores/app.slint";

import "./fonts/poppins.medium.ttf";

export { AppState, AppLogic } from "@stores/app.slint";

export component AppWindow inherits Window {
	preferred-width: 300px;
	preferred-height: 400px;
	default-font-family: "Poppins";
	default-font-size: Style.text-base;
	
	in-out property <[TabsState]> tabs;
	in-out property <string> active-tabs: "calc";
	in-out property <int> counter: 42;

	callback request-increase-value();
	
	VerticalBox {
		if (active-tabs == "calc"): Text {
			text: "Counter: \{root.counter} X";
		}
		if (active-tabs == "var"): Button {
			text: "Increase value";
			clicked => {
				root.request-increase-value();
				AppState.selected-theme = AppState.selected-theme == 1 ? 0 : 1;
			}
		}
		if (active-tabs == "stg"): Rectangle {
			background: AppState.screen-width > 400px ? red : blue;
			preferred-height: 300px;
		}

		TabsGroup {
			id: "main-nav";
			state: tabs[0];
			// size: "sm";
		}
	}

	changed width => {
		AppState.screen-width = self.width;
		AppState.screen = Breakpoint.get-breakpoint(self.width);
	}
	
}
