import { VerticalBox } from "std-widgets.slint";
import { Font, Theme, } from "@styles";
import { AppState, AppLogic, TabsState, SemanticSize } from "@stores/app.slint";
import { TabsGroup, Tabs } from "@components/tabs.slint";
import { ButtonTrigger } from "@components/modal.slint";
import { FieldInput } from "@components/text-edit.slint";
import { Toast } from "@components/toast.slint";
import { CalcDiff } from "@components/calc-diff.slint";
import { SettingsModal } from "@components/settings-modal.slint";
import { ShortcutModal, HelpModal } from "@components/help-modal.slint";

import "./fonts/poppins.medium.ttf";
import "./fonts/poppins.semibold.ttf";

export { AppState, AppLogic, AppData } from "@stores/app.slint";
export { Palette } from "std-widgets.slint";
export { Theme } from "@styles";

export component AppWindow inherits Window {
	title: "VoruCalc";
	icon: @image-url("../assets/icons/256px/vorucalc.png");
	background: AppState.palette.color-base-300;
	// no-frame: true;
	// resize-border-width: 2px;
	min-width: 240px;
	min-height: 144px;
	preferred-width: 300px;
	preferred-height: 400px;
	default-font-family: "Poppins";
	default-font-size: Font.base;
	forward-focus: scope;
	
	in-out property <[TabsState]> tabs;
	in-out property <string> active-tabs: "calc";
	property <bool> show-err: AppState.user-settings.show-err-msg.value && AppState.error-msg != "";

	scope := FocusScope {
		VerticalBox {
			property <length> font-size: AppState.user-settings.font-size.value == SemanticSize.xs ? Font.xs
									: AppState.user-settings.font-size.value == SemanticSize.sm ? Font.sm
									: AppState.user-settings.font-size.value == SemanticSize.md ? Font.base
									: AppState.user-settings.font-size.value == SemanticSize.lg ? Font.lg
									: AppState.user-settings.font-size.value == SemanticSize.xl ? Font.xl
									: AppState.user-settings.font-size.value == SemanticSize.xxl ? Font.x2l : Font.base;
			
			if (active-tabs == "calc"): calc := CalcDiff {
				font-size: parent.font-size;
			}
			if (active-tabs == "var"): var := FieldInput {
				font-size: parent.font-size;
				text <=> AppState.var;
				placeholder: "abc = 10";
				move-to-last-on-init: true;
				edited => {
					AppLogic.parse-calc();
				}
				on-init => {
					self.focus();
				}
			}
			if (active-tabs == "note"): note := FieldInput {
				font-size: parent.font-size;
				text <=> AppState.note;
				placeholder: "Your note here...";
				move-to-last-on-init: true;
				on-init => {
					self.focus();
				}
			}

			// toast (error message)
			if (root.show-err): Rectangle {
				vertical-stretch: 0;

				Toast {
					text <=> AppState.error-msg;
					variant: "error";
				}
			}

			// menu tabs
			if (!AppState.hide-menu): Rectangle {
				vertical-stretch: 0;

				HorizontalLayout {
					spacing: 4px;
	
					TabsGroup {
						id: "main-nav";
						state: tabs[0];
						show-label-length: 120px;
						width-limit: AppState.screen-width - 48px;
					}
					ButtonTrigger {
						bg-color: AppState.palette.color-base-200;
						color: AppState.palette.color-base-content;
						height: 36px; width: 36px; padding-x: 0px;
						icon: @image-url("icons/cog.svg");
						on-click => {
							settings.show();
						}
					}
				}
			} 
		}
		
		// shortcuts
		KeyBinding {
			keys: @keys(Control + "1");
			activated => {
				AppLogic.select-tab("main-nav", 0);
			}
		}
		KeyBinding {
			keys: @keys(Control + "2");
			activated => {
				if (AppState.user-settings.separate-var.value || AppState.user-settings.show-notes.value) {
					AppLogic.select-tab("main-nav", 1);
				}
			}
		}
		KeyBinding {
			keys: @keys(Control + "3");
			activated => {
				if (AppState.user-settings.separate-var.value && AppState.user-settings.show-notes.value) {
					AppLogic.select-tab("main-nav", 2);
				}
			}
		}
		KeyBinding {
			keys: @keys(Control + ",");
			activated => {
				settings.show();
			}
		}
		KeyBinding {
			keys: @keys(Control + "/");
			activated => {
				shortcut.show();
			}
		}
		KeyBinding {
			keys: @keys(F1);
			activated => {
				help.show();
			}
		}
		KeyBinding {
			keys: @keys(F10);
			activated => {
				AppState.hide-menu = !AppState.hide-menu;
			}
		}
		KeyBinding {
			keys: @keys(F11);
			activated => {
				root.full-screen = !root.full-screen;
			}
		}

		// modals
		settings := SettingsModal {
			dialog-width: root.width;
			dialog-height: root.height;
		}
		shortcut := ShortcutModal {
			dialog-width: root.width;
			dialog-height: root.height;
		}
		help := HelpModal {
			dialog-width: root.width;
			dialog-height: root.height;
		}
	}

	changed width => {
		AppState.screen-width = self.width;
	}
}
