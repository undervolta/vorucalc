import { Theme, ThemePalette } from "@styles";

export struct TabsType {
	name: string,
	label: string,
	icon: string,
	is-active: bool,
	width: length
}

export struct TabsState {
	id: string,
	selected: int,
	tabs: [TabsType]
}

export enum SemanticSize {
	xxs,
	xs,
	sm,
	md,
	lg,
	xl,
	xxl
}

export enum UserSettingType {
	DarkMode,
	ShowErrMessage,
	ShowNotes,
	SeparateVariable,
	SaveOnClose,
	DecimalPrecision,
	DecimalSeparator,
	DigitSeparator,
	FontSize
}

export struct UserSettings {
	dark-mode: { title: string, value: bool },
	show-err-msg: { title: string, value: bool },
	show-notes: { title: string, desc: string, value: bool },
	separate-var: { title: string, desc: string, value: bool },
	save-on-close: { title: string, value: bool },
	decimal-prec: { title: string, desc: string, value: string },
	decimal-separator: { title: string, desc: string, value: string },
	digit-separator: { title: string, desc: string, value: string },
	font-size: { title: string, value: SemanticSize },
}

export struct SettingsOption {
	type: UserSettingType,
	label: string,
	desc: string,
	checked: bool,
	text: string,
	size: SemanticSize,
	input-type: int,		// 1 = switch, 2 = input, 3 = dropdown (SemanticSize)
}

export struct StringPair {
	key: string,
	value: string
}

export struct HelpPair {
	label: string,
	value: string,
	example: string,
	is-header: bool
}

export global AppState {
	in-out property <int> selected-theme: 1;	// index
	in-out property <ThemePalette> palette: Theme.list[selected-theme];
	in property <length> screen-width;
	in property <length> calc-width: 200px;
	in property <length> calc-height: 100px;
	in property <bool> hide-menu: false;
	in-out property <string> calc-input;
	in-out property <string> calc-res;
	in-out property <string> var;
	in-out property <string> note;
	in-out property <string> error-msg;
	in-out property <UserSettings> user-settings;
}

export global AppLogic {
	callback refresh-tab(string);						// (id)
	callback select-tab(string, int);					// (id, selected)
	callback parse-calc();
	callback save-settings([SettingsOption]);
}

export global AppData {
	out property <[SettingsOption]> settings: [
		{ type: DarkMode, input-type: 1, label: AppState.user-settings.dark-mode.title, desc: "", checked: AppState.user-settings.dark-mode.value },
		{ type: ShowErrMessage, input-type: 1, label: AppState.user-settings.show-err-msg.title, checked: AppState.user-settings.show-err-msg.value },
		{ type: ShowNotes, input-type: 1, label: AppState.user-settings.show-notes.title, desc: AppState.user-settings.show-notes.desc, checked: AppState.user-settings.show-notes.value },
		{ type: SeparateVariable, input-type: 1, label: AppState.user-settings.separate-var.title, desc: AppState.user-settings.separate-var.desc, checked: AppState.user-settings.separate-var.value },
		{ type: SaveOnClose, input-type: 1, label: AppState.user-settings.save-on-close.title, checked: AppState.user-settings.save-on-close.value },
		{ type: DecimalPrecision, input-type: 3, label: AppState.user-settings.decimal-prec.title, desc: AppState.user-settings.decimal-prec.desc, text: AppState.user-settings.decimal-prec.value },
		{ type: DecimalSeparator, input-type: 2, label: AppState.user-settings.decimal-separator.title, desc: AppState.user-settings.decimal-separator.desc, text: AppState.user-settings.decimal-separator.value },
		{ type: DigitSeparator, input-type: 2, label: AppState.user-settings.digit-separator.title, desc: AppState.user-settings.digit-separator.desc, text: AppState.user-settings.digit-separator.value },
		{ type: FontSize, input-type: 4, label: AppState.user-settings.font-size.title, size: AppState.user-settings.font-size.value },
	];
	in property <[StringPair]> shortcut-list;
	in property <[HelpPair]> help-list;
}
