struct ThemePalette {
	name: string,
	color-base-100: color,
	color-base-200: color,
	color-base-300: color,
	color-base-content: color,
	color-primary: color,
	color-primary-content: color,
	color-secondary: color,
	color-secondary-content: color,
	color-accent: color,
	color-accent-content: color,
	color-neutral: color,
	color-neutral-content: color,
	color-info: color,
	color-info-content: color,
	color-success: color,
	color-success-content: color,
	color-warning: color,
	color-warning-content: color,
	color-error: color,
	color-error-content: color,
	radius-selector: length,
	radius-field: length,
	radius-box: length,
	size-selector: length,
	size-field: length,
	border: length
}

