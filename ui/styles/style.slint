// export { Font, Size } from "@libs/style.slint";

export global Font {
	// Font size
	out property <length> xs:   12px;
	out property <length> sm:   14px;
	out property <length> base: 16px;
	out property <length> lg:   18px;
	out property <length> xl:   20px;
	out property <length> x2l:  24px;
	out property <length> x3l:  30px;
	out property <length> x4l:  36px;
	out property <length> x5l:  48px;
	out property <length> x6l:  60px;
	out property <length> x7l:  72px;
	out property <length> x8l:  96px;
	out property <length> x9l: 128px;

	// Font weight
	out property <int> thin:       100;
	out property <int> extralight: 200;
	out property <int> light:      300;
	out property <int> normal:     400;
	out property <int> medium:     500;
	out property <int> semibold:   600;
	out property <int> bold:       700;
	out property <int> extrabold:  800;
	out property <int> black:      900;

	// Font family
	out property <string> sans: "Inter";
	out property <string> serif: "Georgia";
	out property <string> mono: "JetBrains Mono";

	// Font style
	out property <bool> italic: true;
}

export global Size {
	// Spacing
	out property <length> space-0:   0px;
	out property <length> space-px:  1px;
	out property <length> space-0_5: 2px;
	out property <length> space-1:   4px;
	out property <length> space-1_5: 6px;
	out property <length> space-2:   8px;
	out property <length> space-2_5: 10px;
	out property <length> space-3:   12px;
	out property <length> space-3_5: 14px;
	out property <length> space-4:   16px;
	out property <length> space-5:   20px;
	out property <length> space-6:   24px;
	out property <length> space-7:   28px;
	out property <length> space-8:   32px;
	out property <length> space-9:   36px;
	out property <length> space-10:  40px;
	out property <length> space-11:  44px;
	out property <length> space-12:  48px;
	out property <length> space-14:  56px;
	out property <length> space-16:  64px;
	out property <length> space-20:  80px;
	out property <length> space-24:  96px;
	out property <length> space-28: 112px;
	out property <length> space-32: 128px;
	out property <length> space-36: 144px;
	out property <length> space-40: 160px;
	out property <length> space-44: 176px;
	out property <length> space-48: 192px;
	out property <length> space-52: 208px;
	out property <length> space-56: 224px;
	out property <length> space-60: 240px;
	out property <length> space-64: 256px;
	out property <length> space-72: 288px;
	out property <length> space-80: 320px;
	out property <length> space-96: 384px;


	// Scale
	out property <float> scale-0:    0.0;
	out property <float> scale-5:    0.05;
	out property <float> scale-10:   0.10;
	out property <float> scale-15:   0.15;
	out property <float> scale-20:   0.20;
	out property <float> scale-25:   0.25;
	out property <float> scale-30:   0.30;
	out property <float> scale-35:   0.35;
	out property <float> scale-40:   0.40;
	out property <float> scale-45:   0.45;
	out property <float> scale-50:   0.50;
	out property <float> scale-55:   0.55;
	out property <float> scale-60:   0.60;
	out property <float> scale-65:   0.65;
	out property <float> scale-70:   0.70;
	out property <float> scale-75:   0.75;
	out property <float> scale-80:   0.80;
	out property <float> scale-85:   0.85;
	out property <float> scale-90:   0.90;
	out property <float> scale-95:   0.95;
	out property <float> scale-100:  1.00;

	// Height/width
	out property <length> size-px:  1px;
	out property <length> size-0:   0px;
	out property <length> size-1:   4px;
	out property <length> size-2:   8px;
	out property <length> size-3:   12px;
	out property <length> size-4:   16px;
	out property <length> size-5:   20px;
	out property <length> size-6:   24px;
	out property <length> size-8:   32px;
	out property <length> size-10:  40px;
	out property <length> size-12:  48px;
	out property <length> size-16:  64px;
	out property <length> size-20:  80px;
	out property <length> size-24:  96px;
	out property <length> size-32: 128px;
	out property <length> size-40: 160px;
	out property <length> size-48: 192px;
	out property <length> size-56: 224px;
	out property <length> size-64: 256px;
}
