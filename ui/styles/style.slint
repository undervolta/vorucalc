	out property <int> font-semibold:   600;
	out property <int> font-bold:       700;
	out property <int> font-extrabold:  800;
	out property <int> font-black:      900;

	// Font family
	// These are tokens rather than exact Tailwind CSS stacks.
	// Slint expects a font family name available on the system.
	out property <string> font-sans: "Inter";
	out property <string> font-serif: "Georgia";
	out property <string> font-mono: "JetBrains Mono";

	// Font style
	out property <bool> italic: true;

	// Spacing
	out property <length> space-0:   0px;
