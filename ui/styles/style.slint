	// Shadows
	//
	// Slint doesn't have CSS box-shadow as one token, but it has
	// the equivalent drop-shadow properties:
	//
	// offset-x
	// offset-y
	// blur
	// spread
	// color
	//
	// So these are represented as individual tokens.

	// Small
	out property <length> shadow-sm-x: 0px;
	out property <length> shadow-sm-y: 1px;
	out property <length> shadow-sm-blur: 3px;
	out property <length> shadow-sm-spread: 0px;
	out property <color> shadow-sm-color: #0000001a;

	// Medium
	out property <length> shadow-md-x: 0px;
	out property <length> shadow-md-y: 4px;
	out property <length> shadow-md-blur: 6px;
	out property <length> shadow-md-spread: -1px;
	out property <color> shadow-md-color: #0000001a;

	// Large
	out property <length> shadow-lg-x: 0px;
	out property <length> shadow-lg-y: 10px;
	out property <length> shadow-lg-blur: 15px;
