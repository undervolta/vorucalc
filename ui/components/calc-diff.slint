import { FieldInput } from "@components/text-edit.slint";
import { AppState, AppLogic, SemanticSize } from "@stores/app.slint";
import { Font } from "@styles";

export component CalcDiff inherits FocusScope {
	in property <length> font-size;
	property <length> vert-bar-height: 8px;
	
	forward-focus: input;

	Rectangle {
		main := Rectangle {
			x: 0px; y: 0px;
			opacity: root.enabled ? 1 : 0;
			height: AppState.user-settings.separate-var.value 
				? parent.height : clamp(AppState.calc-height, 64px, max(64px, parent.height - 72px));
	
			input := FieldInput {
				x: 0;
				width: clamp(AppState.calc-width, 100px, max(100px, parent.width - 108px));
				font-size: root.font-size;
				text <=> AppState.calc-input;
				placeholder: "10 + 6";
				enabled: root.enabled;
				move-to-last-on-init: true;
	
				edited => { AppLogic.parse-calc(); }
				on-init => { self.focus(); }
				on-scroll => {
					output.scroll-y = self.scroll-y;
				}
			}
	
			bar := Rectangle {
				x: input.width;
				width: 8px;
				opacity: root.enabled ? 1 : 0;
	
				TouchArea {
					mouse-cursor: ew-resize;
					enabled: root.enabled;
	
					moved => {
						if (self.pressed) {
							AppState.calc-width = max(100px, min(
								root.width - bar.width - 100px,
								AppState.calc-width + self.mouse-x - self.pressed-x
							));
						}
					}
				}
	
				if (root.enabled): Image {
					source: @image-url("../icons/vertical-dots.svg");
					colorize: AppState.palette.color-neutral-content;
				}
			}
	
			output := FieldInput {
				x: bar.x + bar.width;
				width: max(parent.width - self.x, 0px);
				read-only: true;
				font-size: root.font-size;
				font-weight: 600;
				text <=> AppState.calc-res;
				enabled: root.enabled;
			}
		}

		if (!AppState.user-settings.separate-var.value): vert-bar := Rectangle {
			y: main.height;
			height: root.vert-bar-height;
			opacity: root.enabled ? 1 : 0;

			TouchArea {
				mouse-cursor: ns-resize;
				enabled: root.enabled;

				moved => {
					if (self.pressed) {
						AppState.calc-height = max(64px, min(
							root.height - root.vert-bar-height - 64px,
							AppState.calc-height + self.mouse-y - self.pressed-y
						));
					}
				}
			}

			if (root.enabled): Image {
				source: @image-url("../icons/vertical-dots.svg");
				colorize: AppState.palette.color-neutral-content;
				transform-rotation: 90deg;
			}
		}

		if (!AppState.user-settings.separate-var.value): var-list := FieldInput {
			y: main.height + root.vert-bar-height;
			height: max(parent.height - self.y, 0px);
			text <=> AppState.var;
			placeholder: "abc = 10";
			font-size: root.font-size;
			enabled: root.enabled;
			edited => { AppLogic.parse-calc(); }
		}
	}
}
