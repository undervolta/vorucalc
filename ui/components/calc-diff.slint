import { FieldInput } from "@components/text-edit.slint";
import { AppState, AppLogic, SemanticSize } from "@stores/app.slint";
import { Font } from "@styles";

export component CalcDiff inherits FocusScope {
	in-out property <length> input-len;
	out property <length> font-size: AppState.user-settings.font-size.value == SemanticSize.xs ? Font.xs
							: AppState.user-settings.font-size.value == SemanticSize.sm ? Font.sm
							: AppState.user-settings.font-size.value == SemanticSize.md ? Font.base
							: AppState.user-settings.font-size.value == SemanticSize.lg ? Font.lg
							: AppState.user-settings.font-size.value == SemanticSize.xl ? Font.xl
							: AppState.user-settings.font-size.value == SemanticSize.xxl ? Font.x2l : Font.base;
	
	forward-focus: input;

	Rectangle {
		opacity: root.enabled ? 1 : 0;

		input := FieldInput {
			x: 0;
			width: max(root.input-len, 100px);
			font-size: root.font-size;
			text <=> AppState.calc-input;
			enabled: root.enabled;
			move-to-last-on-init: true;

			edited => {
				AppLogic.parse-calc();
			}
			on-init => {
				self.focus();
			}
		}

		bar := Rectangle {
			x: root.input-len;
			width: 8px;
			opacity: root.enabled ? 1 : 0;

			ta := TouchArea {
				mouse-cursor: ew-resize;
				enabled: root.enabled;

				moved => {
					if (self.pressed) {
						root.input-len = max(
							100px,
							min(
								root.width - bar.width - 100px,
								root.input-len + self.mouse-x - self.pressed-x
							)
						);
					}
				}
			}

			if (root.enabled): Image {
				source: @image-url("../icons/vertical-dots.svg");
				colorize: AppState.palette.color-neutral-content;
			}
		}

		FieldInput {
			x: min(bar.x + bar.width, parent.width - 100px);
			width: max(parent.width - root.input-len - bar.width, 100px);
			read-only: true;
			font-size: root.font-size;
			font-weight: 600;
			text <=> AppState.calc-res;
			enabled: root.enabled;
		}
	}
}
