// import { Style, Theme } from "@styles";
import { 
	AppState, AppLogic,
	TabsState, TabsType
} from "@stores/app.slint";

import { TooltipUp } from "@components/tooltip.slint";
import { Font } from "@styles";

export component Tabs inherits Rectangle {
	in property <int> id;
	in property <string> parent_id;
	in property <string> label;
	in property <image> icon;
	in-out property <bool> is-active;
	in property <length> pref-width;
	in property <bool> show-label;

	y: ta.pressed ? 2px : 0px;
	min-width: pref-width;
    preferred-width: pref-width;

	bg := Rectangle {
		x: 3px; y: 3px;
		width: parent.width - 6px;
		height: parent.height - 6px;
		border-radius: AppState.palette.radius-box;
		background: ta.has-hover && !is-active ? (AppState.palette.is-dark ? Colors.white : Colors.black).transparentize(0.8) : transparent;
		
		animate background {
			duration: 300ms;
			easing: ease-out-quint;
		}
	}

	HorizontalLayout {
		spacing: 8px;
		alignment: center;
		cross-axis-alignment: center;
		
		if (icon.width > 0): Image {
			source: icon;
			colorize: is-active ? AppState.palette.color-primary-content : AppState.palette.color-base-content;
			width: 14px;

			animate colorize {
				duration: 300ms;
				easing: ease-out-quint;
			}
		}
	
		if (root.show-label): VerticalLayout {
			padding-top: 1px;

			Text {
				font-size: Font.sm;
				text: label;
				color: is-active ? AppState.palette.color-primary-content : AppState.palette.color-base-content;
	
				animate color {
					duration: 300ms;
					easing: ease-out-quint;
				}
			}
		} 
	}
	
	ta := TouchArea {
		mouse-cursor: pointer;
		clicked => {
			AppLogic.select-tab(parent_id, id);
		}
	}

	if (!show-label): TooltipUp {
		text: label;
		target-x: parent.width / 2;
		target-y: parent.y - parent.height - 10px;
		show: ta.has-hover;
	}

	animate y {
		duration: 300ms;
		easing: ease-out-quint;
	}
}

export component TabsGroup inherits Rectangle {
	in property <string> id;
	in-out property <TabsState> state;
	in property <length> width-limit;
	in property <length> show-label-length;
	property <bool> show-items-label: width-limit / state.tabs.length >= show-label-length;
	// in property <string> size: "md";

	height: 36px;

	main := Rectangle {
		border-radius: AppState.palette.radius-box;
		background: AppState.palette.color-base-200;
		drop-shadow-color: AppState.palette.color-neutral.transparentize(0.5);
		drop-shadow-blur: 1px;
		drop-shadow-offset-y: 2px;

		Rectangle {
			x: ((state.selected - 1) * (parent.width / state.tabs.length)) + 3px;
			y: 3px;
			width: parent.width / state.tabs.length - 6px;
			height: parent.height - 6px;
			background: AppState.palette.color-primary;
			border-radius: AppState.palette.radius-box;

			animate x {
				duration: 300ms;
				easing: ease-out-quint;
			}
		}

		HorizontalLayout {
			for tab[idx] in state.tabs: Tabs {
				id: idx;
				parent_id: id;
				label: tab.label;
				icon: tab.icon == "calc" ? @image-url("../icons/calc.svg")
					: tab.icon == "var" ? @image-url("../icons/var.svg")
					: @image-url("../icons/notebook.svg");
				// icon: AppLogic.load-image(tab.icon);
				is-active: state.selected - 1 == idx;
				pref-width: tab.width;
				show-label: root.show-items-label;
			}
		}

		animate background {
			duration: 300ms;
			easing: ease-out-quint;
		}
	}
}
