
import { AppState } from "@stores/app.slint";
import { Button, ButtonProps } from "@components/button.slint";
import { Font } from "@styles";

export component ButtonTrigger inherits Button {
	callback on-click();

	clicked => {
		on-click();
	}
}

export component Modal inherits PopupWindow {
	in property <string> title;
	in-out property <string> size: "sm";
	in-out property <length> modal-width-custom;
	in-out property <length> modal-height-custom;
	out property <length> modal-width: min(self.width, size == "custom" ? modal-width-custom : size == "full" ? self.width
										: size == "2xl" ? 1536px : size == "xl" ? 1280px
										: size == "lg" ? 1024px : size == "md" ? 768px
										: size == "sm" ? 640px : size == "xs" ? 512px
										: size == "2xs" ? 384px : 256px);
	out property <length> modal-height: min(self.height, size == "custom" ? modal-height-custom : size == "full" ? self.height
										: size == "2xl" ? 1152px : size == "xl" ? 960px
										: size == "lg" ? 768px : size == "md" ? 576px
										: size == "sm" ? 480px : size == "xs" ? 384px
										: size == "2xs" ? 288px : 192px);
	property <length> modal-x: self.width / 2 - modal-width / 2;
	property <length> modal-y: self.height / 2 - modal-height / 2;
	in property <length> header-height: 48px;
	in property <length> actions-height: 48px;
	in property <length> actions-pref-width: 80px;
	in property <[ButtonProps]> actions;
	in property <bool> prevent-close: false;
	in-out property <length> modal-y-offset: 0px;
	in-out property <bool> is-opening: false;
	in-out property <bool> is-closing: false;
	in-out property <bool> has-closed: false;
	callback action-clicked(int);
	callback on-close();
	callback on-prevented-close();

	close-policy: no-auto-close;
	forward-focus: fs;

	public function delayed-close() {
		if (!self.prevent-close) {
			root.is-closing = true;
			root.on-close();
	
			bg.opacity = 0;
			content.opacity = 0;
			timer.interval = 300ms;
			timer.running = true;
		} else {
			root.on-prevented-close();
		}
	}

	fs := FocusScope {
		bg := Rectangle {
			opacity: 0;
			background: black.with-alpha(0.4);
	
			animate opacity {
				duration: 300ms;
				easing: ease-out-quint;
			}
		}
	
		TouchArea {
			pointer-event(event) => {
				if (event.button == PointerEventButton.left && event.kind == PointerEventKind.up && (
					self.mouse-x < content.x || self.mouse-x > content.x + content.width ||
					self.mouse-y < content.y || self.mouse-y > content.y + content.height
				)) {
					root.delayed-close();
				}
			}
		}
	
		content := Rectangle {
			x: root.modal-x;
			width: root.modal-width;
			height: min(root.modal-height, root.modal-height + (root.actions.length > 0 ? root.actions-height : 0px));
			opacity: 0;
			background: AppState.palette.color-base-300;
			border-radius: AppState.palette.radius-box;
			drop-shadow-offset-y: 4px;
			drop-shadow-blur: 6px;
			drop-shadow-color: black.with-alpha(0.7);
	
			if (root.title != ""): Rectangle {
				y: 0px; height: root.header-height;
				
				HorizontalLayout {
					padding-left: 16px; padding-right: 16px;
					padding-top: 12px; padding-bottom: 8px;
					alignment: space-between;
					cross-axis-alignment: center;
	
					Text {
						text: root.title;
						font-size: Font.lg;
						font-weight: Font.semibold;
						color: AppState.palette.color-base-content;
						overflow: elide;
					}
					Button {
						icon: @image-url("../icons/close.svg");
						color: AppState.palette.color-base-content;
						height: 28px; width: 28px; padding-x: 0px;
						font-size: Font.lg;
						is-ghost: true;
						clicked => { root.delayed-close(); }
					}
				}
	
				Rectangle {
					x: 16px; y: root.header-height + 4px; width: parent.width - 32px;
					background: AppState.palette.color-neutral.with-alpha(0.5);
					height: 2px;
					border-radius: 1px;
				}
			}
	
			Rectangle {
				y: root.title == "" ? 0px : root.header-height + 4px;
				height: (root.title == "" ? parent.height : parent.height - (root.header-height + 8px)) - (root.actions.length > 0 ? root.actions-height : 0px);
	
				@children
			}
	
			if (actions.length > 0): Rectangle {
				y: parent.height - root.actions-height; 
				height: root.actions-height;
				
				HorizontalLayout {
					spacing: 8px;
					padding-left: 16px; padding-right: 16px;
					alignment: end;
					cross-axis-alignment: start;
	
					for action[idx] in actions: Button {
						preferred-width: root.actions-pref-width;
						height: 32px;
						font-size: Font.sm;
						padding-x: 4px;
						type: action.type;
						text: action.text;
						icon: action.icon;
						color: action.color;
						bg-color: action.bg-color;
						clicked => { root.action-clicked(idx); }
					}
				}
			}
	
			states [
				init when (!root.is-opening && !root.is-closing) || root.is-closing: {
					y: max(0px, root.modal-y + root.modal-y-offset + 12px);
				}
				anim-in when root.is-opening && !root.is-closing: {
					y: max(0px, root.modal-y + root.modal-y-offset);
				}
			]
	
			animate opacity, y {
				duration: 300ms;
				easing: ease-out-quint;
			}
		}

		KeyBinding {
			keys: @keys(Escape);
			activated => {
				root.delayed-close();
			}
		}
	}


	timer := Timer {
		interval: 10ms;

		triggered => {
			self.running = false;

			if (!root.is-opening) {
				root.is-opening = true;

				bg.opacity = 1;
				content.opacity = 1;
			} else if (root.is-closing) {
				root.close();
			}
		}
	}
}
